{
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{cubecraft.db,bedrock_leaderboards_snapshot.json,bedrock_marketplace_snapshot.json,static/**,*.py}"
    }
  },
  "rewrites": [
    {
      "source": "/api/interactions",
      "destination": "/api/interactions"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__path=/$1"
    }
  ]
}
