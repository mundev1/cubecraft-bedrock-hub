{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{cubecraft.db,bedrock_leaderboards_snapshot.json,bedrock_marketplace_snapshot.json,static/**,*.py}"
    }
  },
  "routes": [
    {
      "src": "/api/interactions",
      "dest": "api/interactions.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
